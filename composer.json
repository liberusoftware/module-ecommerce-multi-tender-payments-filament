{
    "name": "liberusoftware/ecommerce-multi-tender-payments-filament",
    "description": "Filament operator surface for Liberu Ecommerce multi-tender payments: payment plans, the append-only tender ledger, outstanding balances, and recorded reversals.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-multi-tender-payments"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/actions": "^5.0",
        "filament/filament": "^5.0",
        "filament/forms": "^5.0",
        "filament/infolists": "^5.0",
        "filament/notifications": "^5.0",
        "filament/schemas": "^5.0",
        "filament/support": "^5.0",
        "filament/tables": "^5.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "liberusoftware/ecommerce-multi-tender-payments": "^0.1.0"
    },
    "require-dev": {
        "blade-ui-kit/blade-heroicons": "^2.6",
        "blade-ui-kit/blade-icons": "^1.7",
        "liberusoftware/ecommerce-multi-tender-payments": "^0.1.0",
        "liberusoftware/package-testbench": "^1.8",
        "livewire/livewire": "^4.1",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\MultiTenderPayments\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\MultiTenderPayments\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-multi-tender-payments-filament"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
